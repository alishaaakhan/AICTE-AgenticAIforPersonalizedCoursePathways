# ============================================================
# LearnMate – IBM Cloud / IBM Granite Configuration
# ============================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit the actual .env file.
#
# Get credentials at: https://cloud.ibm.com/
# IBM watsonx.ai project:  https://dataplatform.cloud.ibm.com

# IBM Cloud IAM API key  →  https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your_ibm_api_key_here

# watsonx.ai project ID  →  your project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Service endpoint (choose your region)
#   https://us-south.ml.cloud.ibm.com   (Dallas  – default)
#   https://eu-de.ml.cloud.ibm.com      (Frankfurt)
#   https://au-syd.ml.cloud.ibm.com     (Sydney)
#   https://jp-tok.ml.cloud.ibm.com     (Tokyo)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID  (must be available in your region)
# Run `python -c "from app import app; ..."` to list supported models.
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── App settings ─────────────────────────────────────────
DATA_DIR=./data
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
PORT=5000
